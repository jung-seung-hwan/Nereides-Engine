  <!-- fxc는 출력 폴더를 만들어 주지 않는다. -->
  <Target Name="EnsureShaderOutputDir" BeforeTargets="FxCompile">
    <MakeDir Directories="$(OutDir)Shaders" />
  </Target>
  <!-- 소스 .hlsl/.hlsli 사본도 exe 옆에 둔다. .cso가 없을 때의 런타임 컴파일 폴백과 소스 트리가 없는 환경(배포)에서의 핫리로드 대상이다. -->
  <Target Name="CopyShaderSources" AfterTargets="Build">
    <ItemGroup>
      <ShaderSourceFiles Include="$(MSBuildProjectDirectory)\Shaders\*.hlsl;$(MSBuildProjectDirectory)\Shaders\*.hlsli" />
    </ItemGroup>
    <Copy SourceFiles="@(ShaderSourceFiles)" DestinationFolder="$(OutDir)Shaders" SkipUnchangedFiles="true" />
  </Target>
